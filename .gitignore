.env
*.env
.env.local
.env.*.local
secrets.properties
local.properties

# Bloqueo específico para Nexus.kt (Ktor configs)
# Evita que se suban archivos con credenciales hardcoded
application.conf
# Pero permite la plantilla si decides crear una
!application.conf.example

